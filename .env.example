# アプリケーション設定
PORT=8000
CONFIG_PATH=config/app_config.yaml

# モード設定
# trueの場合はすべてローカルモード、falseの場合はクラウドモード
USE_LOCAL_MODE=false

# オンライン/オフラインモードを個別に設定（USE_LOCAL_MODEが優先）
STT_ENGINE=cloud  # cloud or local
LLM_ENGINE=cloud  # cloud or local
TTS_ENGINE=cloud  # cloud or local

# OpenAI API設定
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_openai_org_id_here

# クラウドTTS API設定
CLOUD_TTS_API_KEY=your_cloud_tts_api_key_here

# Supabase設定
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ロギング設定
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# セキュリティ設定
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
